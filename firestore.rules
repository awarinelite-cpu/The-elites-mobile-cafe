rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // â”€â”€ USERS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, list:  if request.auth != null && isAdmin();
      allow update:      if request.auth != null && isAdmin();
    }

    // â”€â”€ RESEARCH TOPICS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /researchTopics/{topicId} {
      allow read, list: if true;
      allow write:      if request.auth != null && isAdmin();
    }

    // â”€â”€ TOPICS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /topics/{topicId} {
      allow read, list: if true;
      allow write:      if request.auth != null && isAdmin();
    }

    // â”€â”€ SERVICE REQUESTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // allow list for ALL authenticated users â€” required for where() queries
    // without composite indexes. Security is enforced at the app level.
    match /serviceRequests/{docId} {
      allow create:      if request.auth != null;
      allow list:        if request.auth != null;
      allow read, update: if request.auth != null && (
        resource.data.userId           == request.auth.uid ||
        resource.data.clientId         == request.auth.uid ||
        resource.data.assignedWriterId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if request.auth != null && isAdmin();
    }

    // â”€â”€ ORDER CHATS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /orderChats/{orderId}/messages/{msgId} {
      allow read, list, create: if request.auth != null;
    }

    // â”€â”€ ORDERS (legacy) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /orders/{orderId} {
      allow create:      if request.auth != null;
      allow list:        if request.auth != null;
      allow read, update: if request.auth != null && (
        resource.data.clientId == request.auth.uid || isAdmin()
      );
      allow delete: if request.auth != null && isAdmin();
    }

    // â”€â”€ QUOTES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /quotes/{quoteId} {
      allow read: if request.auth != null && (
        resource.data.clientId == request.auth.uid || isAdmin()
      );
      allow write: if request.auth != null && isAdmin();
    }

    // â”€â”€ MESSAGES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /messages/{messageId} {
      allow read, list, create: if request.auth != null;
    }

    // â”€â”€ ADMIN DM THREADS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /adminMessages/{userId}/messages/{msgId} {
      allow read, list, write: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
    }

    // â”€â”€ PAYMENT SPLITS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /paymentSplits/{docId} {
      allow create: if request.auth != null;
      allow update: if request.auth != null && isAdmin();
      allow list:   if request.auth != null && isAdmin();
      allow read:   if request.auth != null && (
        isAdmin() ||
        resource.data.writerId   == request.auth.uid ||
        resource.data.referrerId == request.auth.uid ||
        resource.data.clientId   == request.auth.uid
      );
    }

    // â”€â”€ NOTIFICATIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /notifications/{docId} {
      allow list:         if request.auth != null && isAdmin();
      allow read, update: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // â”€â”€ HELPER FUNCTIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    function isAdmin() {
      let data = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return data.isAdmin == true || data.role == 'Admin' || data.role == 'admin';
    }

    function isWriter() {
      let data = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return data.isWriter == true || data.role == 'writer';
    }
  }
}
