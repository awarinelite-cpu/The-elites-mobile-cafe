// storage.rules
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Draft/preview files — accessible to order owner if advance paid
    match /orders/{orderId}/draft/{fileName} {
      allow read: if request.auth != null &&
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.clientId == request.auth.uid &&
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.paymentStatus in ['advance_paid', 'in_progress', 'preview_ready', 'final_paid'];
      allow write: if request.auth != null && isAdmin();
    }

    // FINAL files — ONLY accessible after full payment confirmed
    match /orders/{orderId}/final/{fileName} {
      allow read: if request.auth != null &&
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.clientId == request.auth.uid &&
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.paymentStatus == 'final_paid';
      allow write: if request.auth != null && isAdmin();
    }

    // Topic preview files — public read
    match /topics/{topicId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    function isAdmin() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
